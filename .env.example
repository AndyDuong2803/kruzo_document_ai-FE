# Retrieve your GA ID from your GA dashboard
GOOGLE_ANALYTICS_ID=G-XXXXXXX

# Public OCR API
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Production example: set this in the deployment environment after TLS is valid.
# NEXT_PUBLIC_API_BASE_URL=https://api.smartocr.kruzo.tech

# Google Identity Services web client ID. The browser sends only its ID token to the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
