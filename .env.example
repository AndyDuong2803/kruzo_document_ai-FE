# Retrieve your GA ID from your GA dashboard
GOOGLE_ANALYTICS_ID=G-XXXXXXX

# Public OCR API
NEXT_PUBLIC_API_BASE_URL=https://api.smartocr.kruzo.tech

# Google OAuth route exposed by the backend when login is ready
NEXT_PUBLIC_GOOGLE_LOGIN_URL=

# HTTP-only auth cookie names expected from the backend
KRUZO_SESSION_COOKIE=kruzo_session
KRUZO_PERMISSIONS_COOKIE=kruzo_permissions
KRUZO_ROLE_COOKIE=kruzo_role
KRUZO_USER_COOKIE=kruzo_user
